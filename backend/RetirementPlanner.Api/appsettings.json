{
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Port=3306;Database=retirement_planner;User=retirement_planner_app;Password=SET_VIA_USER_SECRETS;"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "RetirementPlanner.Services": "Debug",
      "RetirementPlanner.Controllers": "Debug"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "retirement-planner-api",
    "Audience": "retirement-planner-web",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7,
    "RefreshTokenReuseGraceSeconds": 10
  },
  "RateLimiting": {
    "Auth": {
      "PermitLimit": 10,
      "WindowSeconds": 60
    }
  }
}
